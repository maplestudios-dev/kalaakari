PORT=4000
MONGODB_URI=mongodb://localhost:27017/kalaakaari
JWT_SECRET=replace-with-long-random-string
JWT_EXPIRES=7d
CORS_ORIGIN=http://localhost:5173,http://localhost:5174

# Public origin the API serves uploads from (used in /api/media response URLs).
# In production behind nginx: https://api.kalaakaari.in
# Leave blank locally — the API will fall back to the request's host.
PUBLIC_API_URL=
ADMIN_EMAIL=admin@kalaakaari.in
ADMIN_PASSWORD=ChangeMe123!

# Lead notifications (all optional — degrade silently if blank)
SLACK_WEBHOOK_URL=
NOTIFY_EMAIL_TO=hello@kalaakaari.in
MAIL_FROM=KALAAKAARI <hello@kalaakaari.in>
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
